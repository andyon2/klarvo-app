{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit)",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/require-track-before-commit.sh"
          },
          {
            "type": "command",
            "command": "cd $CLAUDE_PROJECT_DIR/src-tauri && cargo fmt --check 2>&1 || true",
            "timeout": 60,
            "statusMessage": "Checking cargo fmt..."
          },
          {
            "type": "command",
            "command": "cd $CLAUDE_PROJECT_DIR/src-tauri && cargo clippy -- -D warnings 2>&1 || true",
            "timeout": 120,
            "statusMessage": "Running clippy..."
          },
          {
            "type": "command",
            "command": "cd $CLAUDE_PROJECT_DIR/src-tauri && cargo test 2>&1 || true",
            "timeout": 300,
            "statusMessage": "Running cargo test..."
          }
        ]
      }
    ]
  }
}
