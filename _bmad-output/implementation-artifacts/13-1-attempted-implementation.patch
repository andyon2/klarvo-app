+/// Wire-level mapping of a transcription response: `(status, body)` in,
+/// `Result<String, SttError>` out. What [`DebugStt`] feeds its canned responses
+/// through, so a debug run exercises the real mapping.
+pub(crate) fn map_transcription_response(status: u16, body: &[u8]) -> Result<String, SttError> {
+    if !(200..300).contains(&status) {
+        return Err(map_transcription_error_status(
+            status,
+            &String::from_utf8_lossy(body),
+        ));
+    }
+    map_transcription_body(body)
