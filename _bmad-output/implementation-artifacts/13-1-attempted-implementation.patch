+        match map_transcription_response(500, b"upstream exploded") {
+            Err(SttError::ApiError { status, message }) => {
+                assert_eq!(status, 500);
+                assert_eq!(message, "upstream exploded");
+            }
+            other => panic!("expected ApiError, got {other:?}"),
+        }
+    }
