+// ---------------------------------------------------------------------------
+// Response → Result mapping (shared by WhisperStt and DebugStt)
+// ---------------------------------------------------------------------------
+
+/// Maps a non-2xx transcription response to [`SttError::ApiError`], preferring
+/// the API's own `error.message` and falling back to the raw body.
+///
+/// Extracted verbatim from `WhisperStt::transcribe` (story 13-1,
+/// behaviour-preserving) so [`DebugStt`] reaches it with a canned body.
+fn map_transcription_error_status(status: u16, body: &str) -> SttError {
+    let message = serde_json::from_str::<ApiErrorResponse>(body)
+        .map(|e| e.error.message)
+        .unwrap_or_else(|_| body.to_string());
+    SttError::ApiError { status, message }
+}
+
+/// Maps a 2xx transcription body to the transcript text.
+///
+/// Extracted verbatim from `WhisperStt::transcribe` (story 13-1,
+/// behaviour-preserving — the live path already parsed with
+/// `serde_json::from_slice`, so no error variant changes here).
+///
