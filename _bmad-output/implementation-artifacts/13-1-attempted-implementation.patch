+                    let msg = e.to_string();
+                    assert!(
+                        msg.contains(needle),
+                        "{id}: error message {msg:?} must contain {needle:?}"
+                    );
+                }
+            }
+            other => panic!("{id}: unknown rust.outcome {other}"),
+        }
