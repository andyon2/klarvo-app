+                    expected["text"].as_str().expect("rust.text"),
+                    "{id}: canned transcript must match the fixture"
+                );
+            }
+            "error" => {
+                let e = match result {
+                    Err(e) => e,
+                    Ok(t) => panic!("{id}: expected an error, got Ok({t:?})"),
+                };
