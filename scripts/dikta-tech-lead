#!/usr/bin/env bash
# scripts/dikta-tech-lead -- Startet den Tech Lead als interaktive Session
set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT"

PROMPT_FILE="$PROJECT_ROOT/main-agent.md"
STARTER_PROMPT="Sessionstart: Lies project-status.md und feedback/inbox.md, pruefe Dispatches und architecture.md, dann fasse den Stand zusammen und schlage den naechsten Schritt vor. Wenn neue Feedback-Eintraege da sind, erwaehne sie. Reminder: Wenn ich die Session beende, frage mich ob du committen und pushen sollst."

# --get-prompt: Nur den Starter-Prompt ausgeben (fuer externe Apps)
# --remote: Claude ohne Starter-Prompt starten (fuer Remote Control Flow)
if [[ "${1:-}" == "--get-prompt" ]]; then
  echo "$STARTER_PROMPT"
  exit 0
elif [[ "${1:-}" == "--remote" ]]; then
  exec claude --system-prompt-file "$PROMPT_FILE"
else
  exec claude --system-prompt-file "$PROMPT_FILE" "$STARTER_PROMPT"
fi
