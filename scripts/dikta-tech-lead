#!/usr/bin/env bash
# scripts/dikta-tech-lead -- Startet den Tech Lead als interaktive Session
set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT"
exec claude --system-prompt-file "$PROJECT_ROOT/main-agent.md" \
  "Sessionstart: Lies project-status.md und feedback/inbox.md, pruefe Dispatches und architecture.md, dann fasse den Stand zusammen und schlage den naechsten Schritt vor. Wenn neue Feedback-Eintraege da sind, erwaehne sie. Reminder: Wenn ich die Session beende, frage mich ob du committen und pushen sollst."
