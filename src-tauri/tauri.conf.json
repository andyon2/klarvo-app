{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klarvo",
  "version": "0.5.0",
  "identifier": "com.klarvo.voice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Klarvo · Early Access",
        "width": 480,
        "height": 720,
        "minWidth": 360,
        "minHeight": 400,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/README.txt",
      "resources/RELEASE-NOTES.txt"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["German", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/andyon2/klarvo-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzRkE2QzdEQ0MwRDc2QzAKUldUQWRnM01mV3o2UXdaaXpjTklDdEFMUWM3L28zcEVxNGxycXRLVXI3MG8xMUg2bTZqeTFlWFUK"
    }
  }
}
